# =================================================================
# ResQMesh Environment Configuration (.env.example)
# =================================================================

# Vercel Postgres Database Configuration (Automatically provided by Vercel Postgres Storage)
# Connection pooling URL for Prisma:
POSTGRES_PRISMA_URL="postgres://default:your_password@ep-cool-cloud.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"
# Direct non-pooling URL for migrations / db push:
POSTGRES_URL_NON_POOLING="postgres://default:your_password@ep-cool-cloud.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# Standard database URL fallback:
DATABASE_URL="postgres://default:your_password@ep-cool-cloud.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# JWT Secret for Session Authentication & RBAC
JWT_SECRET="resqmesh_super_secret_jwt_key_2025_disaster_ops"

# Backend Server Port (for local Express server)
PORT=3001

# Frontend API Base URL
# Leave blank on Vercel to route to same-origin /api serverless functions
VITE_API_BASE_URL=

# Application Deployment Environment (development | staging | production)
VITE_APP_ENV=production

# Real-Time Mesh / WebSocket Gateway URL (Optional)
VITE_WS_GATEWAY_URL=

# Map Tile Server Provider URL
VITE_MAP_TILE_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Feature Flags
VITE_ENABLE_OFFLINE_OUTBOX=true
VITE_ENABLE_HARDWARE_HAPTICS=true

# Default Command Center Sector Coordinates (Pune Emergency Center)
VITE_EMERGENCY_SECTOR_LAT=18.5204
VITE_EMERGENCY_SECTOR_LNG=73.8567
