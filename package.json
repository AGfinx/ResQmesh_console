{
  "name": "resqmesh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "build": "prisma generate && tsc -b && vite build",
    "postinstall": "prisma generate",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx server/seed.ts",
    "db:studio": "prisma studio",
    "vercel-build": "prisma generate && tsc -b && vite build"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.3",
    "@capacitor/core": "^8.5.2",
    "@prisma/client": "6.19.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "idb": "^8.0.3",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "prisma": "6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.1",
    "recharts": "^2.15.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.4",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.1"
  }
}
